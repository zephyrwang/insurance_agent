GROQ_API_KEY=gsk_your_groq_api_key_here
DATABASE_URL=sqlite:///./insurance_dev.db

# --- Auth (demo-grade: shared secrets, not a production auth system) ---
# Signs/verifies actor tokens issued by /auth/staff-login and /auth/carrier-login.
APP_SECRET_KEY=change-this-signing-secret
# Single shared passcode for internal staff login.
STAFF_PASSCODE=changeme
# JSON map of carrier_name -> access_code, one per insurance-company account.
CARRIER_ACCESS_CODES={"GEICO": "geico-demo-code", "StateFarm": "statefarm-demo-code"}
